# Copy to .env for local development; on Vercel, set these under
# Project Settings → Environment Variables.

# Optional. A Vercel AI Gateway key: Vercel dashboard → AI Gateway → API Keys
# (https://vercel.com/docs/ai-gateway). Without it the server replays one
# recorded answer, so the app runs without an account and costs nothing.
AI_GATEWAY_API_KEY=

# Optional. Any AI Gateway model id; defaults to anthropic/claude-sonnet-5.5.
# MODEL=openai/gpt-5
